# EditorConfig
# See config/editorconfig for actual config
root = true
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
indent_size = 4
max_line_length = 140

[*.{yml,yaml}]
indent_size = 2

[*.{json,md}]
indent_size = 2

[*.properties]
indent_size = 2

[Makefile]
indent_style = tab

[Dockerfile]
indent_size = 2

[*.sh]
indent_size = 2
