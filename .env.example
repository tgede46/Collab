# Configuration Collab
# Copiez ce fichier en .env et modifiez les valeurs si nécessaire

# === PostgreSQL ===
# Utilisateur de la base de données
POSTGRES_USER=postgres

# Mot de passe (CHANGEZ en production !)
POSTGRES_PASSWORD=postgres

# Nom de la base de données
POSTGRES_DB=collab

# === Spring Boot ===
# URL de connexion PostgreSQL (ne pas changer pour Docker)
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/collab

# Identifiants de connexion
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# === Kafka ===
# Serveur Kafka (ne pas changer pour Docker)
SPRING_KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# === Optionnel ===
# SPRING_PROFILES_ACTIVE=dev
# SERVER_PORT=8080
